<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Vehicle Types -->
    <vType id="passenger" accel="2.6" decel="4.5" sigma="0.5" length="5.0" minGap="2.5" maxSpeed="13.89" guiShape="passenger" color="0.3,0.7,0.9"/>
    <vType id="emergency" accel="3.5" decel="6.0" sigma="0.1" length="6.5" minGap="2.0" maxSpeed="20.0" vClass="emergency" guiShape="emergency" color="1.0,0.0,0.0" speedFactor="1.4"/>

    <!-- Corridor Routes -->
    <route id="r_W1_E1" edges="W1_J1 J1_J2 J2_E1"/>
    <route id="r_E1_W1" edges="E1_J2 J2_J1 J1_W1"/>
    <route id="r_N1_S1" edges="N1_J1 J1_J3 J3_S1"/>
    <route id="r_N2_S2" edges="N2_J2 J2_J4 J4_S2"/>
    <route id="r_W2_E2" edges="W2_J3 J3_J4 J4_E2"/>

    <!-- Background Flows -->
    <flow id="ef_W1_E1" route="r_W1_E1" type="passenger" begin="0" end="3600" period="10"/>
    <flow id="ef_E1_W1" route="r_E1_W1" type="passenger" begin="0" end="3600" period="10"/>
    <flow id="ef_N1_S1" route="r_N1_S1" type="passenger" begin="0" end="3600" period="8"/>
    <flow id="ef_N2_S2" route="r_N2_S2" type="passenger" begin="0" end="3600" period="8"/>
    <flow id="ef_W2_E2" route="r_W2_E2" type="passenger" begin="0" end="3600" period="10"/>

    <!-- Scheduled Emergency Ambulance (traversing EW artery W1 -> J1 -> J2 -> E1) -->
    <vehicle id="ambulance_01" type="emergency" route="r_W1_E1" depart="10"/>
    <vehicle id="ambulance_02" type="emergency" route="r_N1_S1" depart="45"/>
</routes>
